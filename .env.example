# Try the app with built-in sample data and no Supabase or payment keys (data resets on restart)
DEMO_MODE=false

# Public URL of this app (used for gateway callback/return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Organisers: these emails become admins on first sign-in (comma separated)
ADMIN_EMAILS=

# "sandbox" (default) uses each gateway's test environment; set to "production" to go live
PAYMENT_MODE=sandbox
# Shows a "mark as paid" test button. Never enable in production.
ENABLE_DEMO_PAYMENT=false

# Billplz: API key, collection ID
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=

# ToyyibPay: user secret key, category code
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=

# Bayarcash: personal access token, portal key, API secret key
BAYARCASH_PAT=
BAYARCASH_PORTAL_KEY=
BAYARCASH_SECRET_KEY=

# SenangPay: merchant ID, secret key
SENANGPAY_MERCHANT_ID=
SENANGPAY_SECRET_KEY=
